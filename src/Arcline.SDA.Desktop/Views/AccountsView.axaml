<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Arcline.SDA.Desktop.ViewModels"
             x:Class="Arcline.SDA.Desktop.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
  </UserControl.KeyBindings>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Add authenticator to an account..." Command="{Binding AddAuthenticatorCommand}" />
        <Separator />
        <MenuItem Header="_Import maFile..." Command="{Binding ImportMaFileCommand}" />
        <MenuItem Header="Import old _SDA folder..." Command="{Binding ImportSdaFolderCommand}" />
        <MenuItem Header="Import from another _vault / backup..." Command="{Binding ImportVaultCommand}" />
        <MenuItem Header="_Back up vault (for another PC)..." Command="{Binding BackupVaultCommand}" />
        <Separator />
        <MenuItem Header="_Settings..." Command="{Binding SettingsCommand}" />
        <MenuItem Header="_Change vault passphrase..." Command="{Binding ChangePassphraseCommand}" />
        <MenuItem Header="_Lock" Command="{Binding LockCommand}" InputGesture="Ctrl+L" />
        <Separator />
        <MenuItem Header="_Quit" Command="{Binding QuitCommand}" />
      </MenuItem>
      <MenuItem Header="_Account" IsEnabled="{Binding HasSelection}">
        <MenuItem Header="_Log in again..." Command="{Binding LoginAgainCommand}" />
        <MenuItem Header="Acknowledge _trade protection notice" Command="{Binding AcknowledgeTradeProtectionCommand}" />
        <MenuItem Header="_Export maFile..." Command="{Binding ExportCommand}" />
        <Separator />
        <MenuItem Header="Move _up" Command="{Binding MoveUpCommand}" />
        <MenuItem Header="Move _down" Command="{Binding MoveDownCommand}" />
        <Separator />
        <MenuItem Header="_Remove from vault..." Command="{Binding RemoveAccountCommand}" />
        <MenuItem Header="Remove authenticator from Steam..." Command="{Binding DeactivateCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="10,4" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" FontSize="12" />
        <TextBlock Grid.Column="1" Text="time not synced" FontSize="12" Foreground="Orange" IsVisible="{Binding !TimeSynced}" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="260,*">
      <!-- Accounts -->
      <DockPanel Margin="10">
        <TextBox DockPanel.Dock="Top" Watermark="Search accounts" Text="{Binding Search}" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Add authenticator" Command="{Binding AddAuthenticatorCommand}" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Import maFile" Command="{Binding ImportMaFileCommand}" />
        </StackPanel>
        <Grid>
          <ListBox ItemsSource="{Binding FilteredAccounts}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:AccountItem">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="login" Foreground="Orange" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding NeedsLogin}" />
                  <Border Grid.Column="2" CornerRadius="9" MinWidth="18" Padding="5,0" Margin="6,0,0,0" Background="{DynamicResource SystemAccentColor}" IsVisible="{Binding HasPending}">
                    <TextBlock Text="{Binding Pending}" Foreground="White" FontSize="11" HorizontalAlignment="Center" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="No accounts yet. Add an authenticator, import a maFile, or import your old SDA folder from the File menu."
                     TextWrapping="Wrap" Classes="muted" Margin="8" IsVisible="{Binding HasNoAccounts}" />
        </Grid>
      </DockPanel>

      <!-- Selected account -->
      <DockPanel Grid.Column="1" Margin="0,10,10,10" IsVisible="{Binding HasSelection}">
        <Border DockPanel.Dock="Top" Classes="card">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Text="{Binding Selected.Name, FallbackValue=''}" FontSize="16" FontWeight="SemiBold" />
            <SelectableTextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.SteamId, FallbackValue=''}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Classes="code" Text="{Binding Code}" Margin="0,6,0,0" />
            <Button Grid.Row="1" Grid.Column="1" Content="Copy" Command="{Binding CopyCodeCommand}" VerticalAlignment="Center" HotKey="Ctrl+C" />
            <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Minimum="0" Maximum="30" Value="{Binding SecondsLeft}" Height="4" Margin="0,6,0,0" />
          </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,4,0,8">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto">
            <TextBlock Text="{Binding ConfirmationsHeader}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowAllAccounts}" OnContent="All accounts" OffContent="This account"
                          Margin="0,0,10,0" VerticalAlignment="Center" ToolTip.Tip="Show confirmations of every account in one list" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" MinWidth="110" Margin="0,0,6,0"
                      VerticalAlignment="Center" ToolTip.Tip="Filter by type" />
            <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshConfirmationsCommand}" HotKey="F5" ToolTip.Tip="F5" VerticalAlignment="Center" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <CheckBox Content="Select all" IsChecked="{Binding AllSelected}" VerticalAlignment="Center" ToolTip.Tip="Ctrl+A" />
            <Button Grid.Column="1" Classes="accent" Content="{Binding AcceptSelectedText}" Command="{Binding AcceptSelectedCommand}" Margin="0,0,6,0" />
            <Button Grid.Column="2" Content="{Binding DenySelectedText}" Command="{Binding DenySelectedCommand}" />
          </Grid>
        </StackPanel>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding LoadingConfirmations}" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding ConfirmationsError}" TextWrapping="Wrap" Classes="muted" Margin="2,0,0,8"
                   IsVisible="{Binding ConfirmationsError, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Confirmations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:ConfirmationItem">
                <Border Classes="card">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                    <CheckBox Grid.RowSpan="3" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsIdle}" VerticalAlignment="Top" Margin="0,0,8,0" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding AccountName}" FontSize="11" Foreground="{DynamicResource SystemAccentColor}" IsVisible="{Binding ShowAccount}" />
                      <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding TypeText}" Classes="muted" FontSize="12" Margin="8,0,0,0" />
                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding When}" Classes="muted" FontSize="11" Margin="0,4,0,0" />
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                      <Button Classes="accent" Content="{Binding AcceptText}" IsEnabled="{Binding IsIdle}"
                              Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).AcceptCommand, FallbackValue={x:Null}}"
                              CommandParameter="{Binding}" />
                      <Button Content="{Binding CancelText}" IsEnabled="{Binding IsIdle}"
                              Command="{Binding $parent[UserControl].((vm:AccountsViewModel)DataContext).DenyCommand, FallbackValue={x:Null}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,6,0,0"
                               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
