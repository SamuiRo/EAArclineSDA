<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Arcline.SDA.Desktop.ViewModels"
             x:Class="Arcline.SDA.Desktop.Views.UnlockView"
             x:DataType="vm:UnlockViewModel">
  <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
    <StackPanel Spacing="12">
      <Image Source="/Assets/icon.ico" Width="64" Height="64" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Classes="muted" TextAlignment="Center" />
      <TextBox x:Name="PassBox" PasswordChar="&#x2022;" Watermark="Passphrase" Text="{Binding Passphrase}" />
      <TextBox PasswordChar="&#x2022;" Watermark="Repeat passphrase" Text="{Binding Confirm}" IsVisible="{Binding IsNew}" />
      <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsDefault="True"
              Command="{Binding SubmitCommand}">
        <Panel>
          <TextBlock Text="Create vault" IsVisible="{Binding IsNew}" />
          <TextBlock Text="Unlock" IsVisible="{Binding IsExisting}" />
        </Panel>
      </Button>
      <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding IsNew}"
              Content="Moving from another PC? Restore from backup..." Command="{Binding RestoreCommand}" />
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" />
      <SelectableTextBlock Text="{Binding VaultDir, StringFormat='Vault: {0}'}" FontSize="11" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
        <Button Content="Open another vault..." Command="{Binding OpenOtherVaultCommand}" FontSize="12" />
        <Button Content="New vault in another folder..." Command="{Binding CreateVaultElsewhereCommand}" FontSize="12" />
      </StackPanel>
      <StackPanel Spacing="2" IsVisible="{Binding HasRecentVaults}">
        <TextBlock Text="Recent vaults" FontSize="11" Classes="muted" HorizontalAlignment="Center" />
        <ItemsControl ItemsSource="{Binding RecentVaults}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Button FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Background="Transparent" Padding="6,2" ToolTip.Tip="{Binding}"
                      Command="{Binding $parent[UserControl].((vm:UnlockViewModel)DataContext).OpenRecentCommand, FallbackValue={x:Null}}"
                      CommandParameter="{Binding}">
                <TextBlock Text="{Binding}" TextTrimming="LeadingCharacterEllipsis" TextAlignment="Center" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
