<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Arcline.SteamGuard</RootNamespace>
    <Description>Cross-platform Steam Guard core: encrypted maFile vault, Steam Guard codes, mobile confirmations, session refresh, authenticator linking.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CA5350: HMAC-SHA1 is mandated by Steam's TOTP/confirmation protocol, not our choice. -->
    <NoWarn>$(NoWarn);CS1591;CA5350;CA1001</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>Arcline.SteamGuard</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SteamKit2" Version="3.5.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Arcline.SteamGuard.Tests" />
  </ItemGroup>
</Project>
